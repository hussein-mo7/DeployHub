    {
      "name": "Phase 10 — Webhook",
      "item": [
        {
          "name": "10.1 Enable auto deploy",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"autoDeployEnabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/environments/{{environmentId}}",
            "description": "Environment branch must match webhook ref."
          }
        },
        {
          "name": "10.2 Simulate push webhook",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get('githubWebhookSecret');",
                  "if (!secret) { throw new Error('Set githubWebhookSecret in environment'); }",
                  "const owner = pm.environment.get('repoOwner');",
                  "const repo = pm.environment.get('repoName');",
                  "const installId = pm.environment.get('githubInstallationId') || '0';",
                  "const body = JSON.stringify({",
                  "  ref: 'refs/heads/main',",
                  "  after: 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',",
                  "  repository: { full_name: owner + '/' + repo, name: repo },",
                  "  installation: { id: Number(installId) }",
                  "});",
                  "pm.request.body.update(body);",
                  "const sig = 'sha256=' + CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'X-Hub-Signature-256', value: sig });",
                  "pm.request.headers.upsert({ key: 'X-GitHub-Event', value: 'push' });",
                  "pm.request.headers.upsert({ key: 'X-GitHub-Delivery', value: 'postman-' + Date.now() });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/github/webhook",
            "description": "Requires GITHUB_WEBHOOK_SECRET in backend .env and npm run worker."
          }
        }
      ]
    }
