# Copy to backend/.env on your VPS control-plane server.
# Database and Redis run on THIS machine (see docker-compose.prod.yml) — not Neon, not your laptop.

NODE_ENV=production
PORT=3001

# Local Postgres on the VPS (docker compose)
DATABASE_URL="postgresql://deployhub:CHANGE_DB_PASSWORD@127.0.0.1:5432/deployhub?schema=public"

REDIS_URL="redis://127.0.0.1:6379"

# Public URL users open in the browser (HTTPS). Same host is fine if nginx/Caddy proxies /api + UI.
CLIENT_URL="https://deployhub.yourdomain.com"

# URL the deploy TARGET VPS uses (install.sh, agent WebSocket). Must match what agents can reach.
PUBLIC_API_URL="https://deployhub.yourdomain.com"

# Published agent image (see docs/OPERATIONS.md)
AGENT_DOCKER_IMAGE="ghcr.io/YOUR_GITHUB_USER/deployhub-agent:latest"

# Generate strong secrets (do not reuse dev values):
JWT_SECRET=""
ENCRYPTION_KEY=""
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

EMAIL_FROM="DeployHub <noreply@yourdomain.com>"
RESEND_API_KEY=""

GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
