generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  githubInstallation      GitHubInstallation?
  servers                 Server[]
  projects                Project[]
  deployments             Deployment[]
}

enum ServerStatus {
  UNREGISTERED
  CONNECTING
  ONLINE
  OFFLINE
  UNHEALTHY
}

model Server {
  id                         String       @id @default(cuid())
  userId                     String
  name                       String
  description                String?
  status                     ServerStatus @default(UNREGISTERED)
  sshHost                    String?
  sshPort                    Int          @default(22)
  sshUser                    String?
  agentTokenHash             String?      @unique
  registrationTokenHash      String?      @unique
  registrationTokenExpiresAt DateTime?
  lastSeenAt                 DateTime?
  registeredAt               DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  environments Environment[]

  @@index([userId])
}

model GitHubInstallation {
  id                  String   @id @default(cuid())
  userId              String   @unique
  installationId      Int      @unique
  accountLogin        String
  accountType         String
  repositorySelection String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([installationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DeploymentMethod {
  DOCKERFILE
  COMPOSE
  IMAGE
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  repoOwner   String
  repoName    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     Service[]
  environments Environment[]
  deployments  Deployment[]

  @@unique([userId, name])
  @@index([userId])
}

model Service {
  id               String           @id @default(cuid())
  projectId        String
  name             String
  description      String?
  deploymentMethod DeploymentMethod @default(DOCKERFILE)
  dockerfilePath   String           @default("Dockerfile")
  composeFilePath  String           @default("docker-compose.yml")
  imageName        String?
  buildContext     String           @default(".")
  /// TCP port inside the container to publish on the host (same port number), e.g. 3000 for Next.js
  port             Int?
  healthCheckPath  String           @default("/")
  healthCheckEnabled Boolean        @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model Environment {
  id                String   @id @default(cuid())
  projectId         String
  name              String
  serverId          String
  branch            String   @default("main")
  autoDeployEnabled Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  server     Server                  @relation(fields: [serverId], references: [id], onDelete: Restrict)
  variables  EnvironmentVariable[]
  deployments Deployment[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([serverId])
}

model EnvironmentVariable {
  id             String   @id @default(cuid())
  environmentId  String
  key            String
  value          String?
  encryptedValue String?
  isSecret       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([environmentId])
}

enum DeploymentStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum DeploymentTrigger {
  MANUAL
  SAVE_AND_REDEPLOY
  WEBHOOK
  ROLLBACK
}

model Deployment {
  id                         String            @id @default(cuid())
  userId                     String
  projectId                  String
  environmentId              String
  status                     DeploymentStatus  @default(PENDING)
  trigger                    DeploymentTrigger @default(MANUAL)
  /// Git branch used for this deployment (snapshot at deploy time)
  branch                     String?
  /// Commit deployed on success (required for rollback to that version)
  gitCommitSha               String?
  rollbackSourceDeploymentId String?
  errorMessage               String?
  startedAt                  DateTime?
  finishedAt                 DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment              Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  rollbackSourceDeployment Deployment?     @relation("DeploymentRollback", fields: [rollbackSourceDeploymentId], references: [id], onDelete: SetNull)
  rollbackRedeployments    Deployment[]    @relation("DeploymentRollback")
  logs                     DeploymentLog[]

  @@index([userId])
  @@index([projectId])
  @@index([environmentId])
  @@index([status])
  @@index([rollbackSourceDeploymentId])
}

model DeploymentLog {
  id           String   @id @default(cuid())
  deploymentId String
  message      String
  createdAt    DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
}
