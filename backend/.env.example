# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://deployhub:deployhub@localhost:5432/deployhub?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# CORS
CLIENT_URL="http://localhost:5173"
# Public API URL (HTTPS in prod) — used in agent install.sh and VPS reachability
# PUBLIC_API_URL="https://api.yourdomain.com"
# Docker image published from agent/Dockerfile (enables auto docker run in install.sh)
# AGENT_DOCKER_IMAGE="ghcr.io/you/deployhub-agent:latest"

# Auth (Phase 2)
JWT_SECRET="change-me-in-production"
# Access JWT + httpOnly cookie lifetime (seconds). Default: 900 (15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token + httpOnly cookie lifetime (seconds). Default: 604800 (7 days)
REFRESH_TOKEN_TTL_SECONDS=604800

# Encryption (Phase 6)
ENCRYPTION_KEY="change-me-32-characters-minimum!!"

# Email — Resend
# Dev/testing: use Resend's test sender (only sends to your Resend account email)
EMAIL_FROM="DeployHub <onboarding@resend.dev>"
RESEND_API_KEY=""

# GitHub App (Phase 3) — https://github.com/settings/apps
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
# PEM private key — use \n for line breaks in .env
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
